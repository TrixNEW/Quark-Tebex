{
  "name": "trixnew/quark-tebex",
  "description": "Tebex webstore integration for Quark",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "2.1.46"
  },
  "autoload": {
    "psr-4": {
      "Trix\\Tebex\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "build": "php -d phar.readonly=0 build.php",
    "analyse": "phpstan analyse",
    "test": "php tests/run.php"
  }
}
